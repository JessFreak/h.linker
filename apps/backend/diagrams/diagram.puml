  + canActivate(context)
}
class RolesGuard {
  + canActivate(context)
}
class GithubStrategy {
  + validate(req, accessToken, _refreshToken, profile, done)
}
class GoogleStrategy {
  + validate(_accessToken, _refreshToken, profile, done)
}

' ==========================================
' ЦЕНТР
' ==========================================
AppModule -up-> AuthModule
AppModule -down-> PrismaModule
AppModule -left-> TeamModule
AppModule -right-> HackathonModule
AppModule -up-> UserModule

' ==========================================
' AuthModule — вгору і вліво
' ==========================================
AuthModule -down-> AuthController
AuthModule -up-> AuthService
AuthModule -up-> GithubStrategy
AuthModule -right-> GoogleStrategy
AuthModule -left-> GoogleOauthGuard
AuthModule -left-> GithubOauthGuard
AuthModule -left-> GithubConnectGuard
AuthModule -right-> JwtAuthGuard

' Міжмодульні зв'язки
AuthModule -right-> CategoryModule
UserModule -right-> CategoryModule

' ==========================================
' UserModule — вгору і вправо
' ==========================================
UserModule -up-> UserController
UserModule -up-> UserService
UserModule -up-> UserByIdPipe
UserModule -up-> UserByUsernamePipe

' ==========================================
' CategoryModule — вгору і в сторони
' ==========================================
CategoryModule -up-> CategoryController
CategoryModule -up-> CategoryService
CategoryModule -up-> GithubService

' ==========================================
' TeamModule — вліво і вгору/вниз
' ==========================================
TeamModule -left-> TeamController
TeamModule -right-> TeamService
TeamModule -up-> RoleController
TeamModule -down-> RoleService
TeamModule -down-> TeamByIdPipe

' ==========================================
' HackathonModule — рівномірно на всі 4 боки
' вгору: HackathonService, ProjectService
' вправо: HackathonController, ProjectController
' вниз: три Pipes
' вліво нічого — там AppModule
' ==========================================
HackathonModule -left-> HackathonService
HackathonModule -up-> ProjectService
HackathonModule -up-> RolesGuard
HackathonModule -up-> OptionalJwtAuthGuard
HackathonModule -right-> HackathonController
HackathonModule -left-> ProjectController
HackathonModule -down-> HackathonByIdPipe
HackathonModule -down-> HackathonBySlugPipe
HackathonModule -down-> ParticipationByIdPipe
HackathonModule --> HackathonCronService

' ==========================================
' PrismaModule — вниз і в сторони
' ==========================================
PrismaModule -down-> PrismaService
PrismaModule -down-> UserRepository
PrismaModule -left-> CategoryRepository
PrismaModule -left-> RoleRepository
PrismaModule -left-> CriteriaRepository
PrismaModule -right-> TeamRepository
PrismaModule -right-> MemberRepository
PrismaModule -right-> ParticipationRepository
PrismaModule -down-> HackathonRepository
PrismaModule -down-> JuryRepository
PrismaModule -down-> EvaluationRepository

@enduml